{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvla.example/schemas/factorized_v2_scheduler_ready_prediction.schema.json",
  "title": "Factorized V2 scheduler-ready Student prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "episode", "step", "route", "route_supported", "student_valid",
    "candidate_close", "candidate_close_source", "raw_gripper", "raw_gripper_source",
    "candidate_close_source_field", "action_intent", "action_intent_source",
    "action_intent_source_field", "raw_gripper_source_field",
    "utility_probability", "utility_source",
    "release_probability", "release_source", "regrasp_probability", "regrasp_source",
    "uncertainty_probability", "uncertainty_source", "features_25d", "feature_dtype",
    "feature_order_sha256", "checkpoint_sha256", "source_commit", "input_artifact_seal",
    "causal_field_declaration", "field_statuses"
  ],
  "properties": {
    "schema": {"const": "FACTORIZED_V2_SCHEDULER_READY_PREDICTION_V1"},
    "episode": {"type": "string", "pattern": "^[^/]+/task_[0-9]{2}/state_[0-9]{2}$"},
    "step": {"type": "integer", "minimum": 0},
    "route": {"type": "string", "minLength": 1},
    "route_supported": {"type": "boolean"},
    "student_valid": {"type": "boolean"},
    "candidate_close": {"type": "boolean"},
    "candidate_close_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "candidate_close_source_field": {"type": "string", "minLength": 1},
    "raw_gripper": {"type": "number"},
    "raw_gripper_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "raw_gripper_source_field": {"type": "string", "minLength": 1},
    "action_intent": {"enum": ["CLOSE", "OPEN", "BOUNDARY", "UNKNOWN"]},
    "action_intent_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "action_intent_source_field": {"type": "string", "minLength": 1},
    "utility_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "utility_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "release_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "release_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "regrasp_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "regrasp_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "uncertainty_probability": {"type": "number", "const": 0},
    "uncertainty_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "features_25d": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"type": "number"}},
    "feature_dtype": {"const": "float32"},
    "feature_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_artifact_seal": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "causal_field_declaration": {"type": "object", "additionalProperties": true},
    "field_statuses": {"type": "object", "additionalProperties": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]}}
  }
}
