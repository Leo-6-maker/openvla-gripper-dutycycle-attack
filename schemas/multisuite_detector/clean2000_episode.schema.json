{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLEAN2000 Episode Schema",
  "type": "object",
  "required": ["episode_key", "parent_key", "suite", "task_id", "task_name", "state_id", "eval_seed", "clean_success", "mechanism_type", "mechanism_eligible", "teacher_label_valid", "feature_schema_sha256", "source_manifest_sha256", "n_steps", "n_valid_steps"],
  "properties": {
    "episode_key": {"type": "string"},
    "parent_key": {"type": "string"},
    "suite": {"type": "string", "enum": ["libero_object", "libero_spatial", "libero_goal", "libero_10"]},
    "task_id": {"type": "integer", "minimum": 0},
    "task_name": {"type": "string"},
    "state_id": {"type": "integer", "minimum": 0},
    "eval_seed": {"type": "integer"},
    "clean_success": {"type": "boolean"},
    "mechanism_type": {"type": "string"},
    "mechanism_eligible": {"type": "boolean"},
    "teacher_label_valid": {"type": "boolean"},
    "teacher_event_id": {"type": ["string", "null"]},
    "teacher_anchor_step": {"type": ["integer", "null"]},
    "teacher_window_start": {"type": ["integer", "null"]},
    "teacher_window_end": {"type": ["integer", "null"]},
    "teacher_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "feature_schema_sha256": {"type": "string", "minLength": 64},
    "source_manifest_sha256": {"type": "string", "minLength": 64},
    "artifact_inventory_sha256": {"type": "string"},
    "n_steps": {"type": "integer", "minimum": 1},
    "n_valid_steps": {"type": "integer", "minimum": 0},
    "first_valid_step": {"type": "integer", "minimum": 0},
    "invalid_feature_steps": {"type": "integer", "minimum": 0},
    "telemetry_complete": {"type": "boolean"},
    "schema_fail": {"type": "boolean"},
    "infra_fail": {"type": "boolean"},
    "event_id": {"type": ["string", "null"]},
    "event_role": {"type": ["string", "null"], "enum": ["primary", "supplementary", null]},
    "event_count": {"type": ["integer", "null"]},
    "abstain_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
