{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvla.example/schemas/factorized_v2_runtime_scheduler_input.schema.json",
  "title": "Factorized V2 runtime scheduler input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "episode", "step", "route", "route_supported", "student_valid",
    "student_valid_source", "candidate_close", "action_known", "action_intent",
    "raw_gripper", "candidate_close_source", "raw_gripper_source_field",
    "grasp_logit", "grasp_probability", "grasp_source",
    "manipulation_logit", "manipulation_probability", "manipulation_source",
    "release_logit", "release_probability", "release_source",
    "feature_window_valid", "feature_order_sha256", "checkpoint_sha256",
    "source_commit", "prediction_artifact_seal", "runtime_artifact_seal",
    "causal_field_declaration"
  ],
  "properties": {
    "schema": {"const": "FACTORIZED_V2_RUNTIME_SCHEDULER_INPUT_V1"},
    "episode": {"type": "string", "pattern": "^[^/]+/task_[0-9]{2}/state_[0-9]{2}$"},
    "step": {"type": "integer", "minimum": 0},
    "split": {"type": "string", "pattern": "^o[0-3]_i[0-2]$"},
    "scheduler_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structural_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route": {"type": "string", "minLength": 1},
    "route_supported": {"type": "boolean"},
    "student_valid": {"type": "boolean"},
    "student_valid_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "candidate_close": {"type": "boolean"},
    "action_known": {"type": "boolean"},
    "action_intent": {"enum": ["CLOSE", "OPEN", "BOUNDARY", "UNKNOWN"]},
    "raw_gripper": {"type": ["number", "null"]},
    "candidate_close_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "raw_gripper_source_field": {"type": "string", "minLength": 1},
    "grasp_logit": {"type": "number"},
    "grasp_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "grasp_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "manipulation_logit": {"type": "number"},
    "manipulation_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "manipulation_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "release_logit": {"type": "number"},
    "release_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "release_source": {"enum": ["DIRECT", "DERIVED", "MISSING", "FORBIDDEN"]},
    "feature_window_valid": {"type": "boolean"},
    "feature_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prediction_artifact_seal": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_artifact_seal": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "causal_field_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["future_steps_consumed", "teacher_fields_consumed", "attack_fields_consumed"],
      "properties": {
        "future_steps_consumed": {"const": false},
        "teacher_fields_consumed": {"const": false},
        "attack_fields_consumed": {"const": false}
      }
    }
  }
}
