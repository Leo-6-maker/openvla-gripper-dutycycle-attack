{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvla.example/schemas/factorized_v2_offline_policy_selection_bundle.schema.json",
  "title": "Factorized V2 offline policy-selection bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "split", "runtime_record_stream", "evaluation_label_stream", "checkpoint_sha256", "source_commit", "feature_order_sha256", "scheduler_source_sha256", "structural_config_sha256", "calibrator_identity_manifest_sha256", "policy_selection_identity_manifest_sha256", "policy_selection_identities", "formal_selection_eligible", "training_authorized", "attack_authorized"],
  "properties": {
    "schema": {"const": "FACTORIZED_V2_OFFLINE_POLICY_SELECTION_BUNDLE_V1"},
    "split": {"type": "string", "pattern": "^o[0-3]_i[0-2]$"},
    "runtime_record_stream": {"const": "policy_selection_runtime_records.jsonl"},
    "evaluation_label_stream": {"const": "policy_selection_evaluation_labels.jsonl"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "feature_order_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "scheduler_source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "structural_config_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "calibrator_identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "policy_selection_identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "policy_selection_identities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "formal_selection_eligible": {"const": false},
    "training_authorized": {"const": false},
    "attack_authorized": {"const": false}
  }
}
