{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvla.example/schemas/factorized_v2_offline_calibration_bundle.schema.json",
  "title": "Factorized V2 offline calibration bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checkpoint_sha256", "split", "training_identity_manifest_sha256", "feature_input_seal_sha256", "predictor_source_sha256", "record_stream", "fields", "formal_selection_eligible", "training_authorized", "attack_authorized"],
  "properties": {
    "schema": {"const": "FACTORIZED_V2_OFFLINE_CALIBRATION_BUNDLE_V1"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "split": {"type": "string", "pattern": "^o[0-3]_i[0-2]$"},
    "training_identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "feature_input_seal_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "predictor_source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "record_stream": {"type": "string", "minLength": 1},
    "fields": {"const": ["raw_logits", "head_targets", "head_known_masks", "identity", "step", "checkpoint_binding", "training_identity_provenance"]},
    "formal_selection_eligible": {"const": false},
    "training_authorized": {"const": false},
    "attack_authorized": {"const": false}
  }
}
