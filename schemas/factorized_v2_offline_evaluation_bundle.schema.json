{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvla.example/schemas/factorized_v2_offline_evaluation_bundle.schema.json",
  "title": "Factorized V2 offline evaluation bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "split", "data_filename", "record_stream", "checkpoint_sha256", "teacher_label_seal_sha256", "feature_input_seal_sha256", "fields", "formal_selection_eligible", "training_authorized", "attack_authorized"],
  "properties": {
    "schema": {"const": "FACTORIZED_V2_OFFLINE_EVALUATION_BUNDLE_V1"},
    "data_filename": {"const": "evaluation_records.jsonl"},
    "record_count": {"type": "integer", "minimum": 1},
    "identity_count": {"type": "integer", "minimum": 1},
    "teacher_label_seal": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "teacher_root_sha256s_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "identity_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "runtime_fields_consumed": {"const": false},
    "student_input_consumed": {"const": false},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "split": {"type": "string", "pattern": "^o[0-3]_i[0-2]$"},
    "teacher_label_seal_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "feature_input_seal_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "record_stream": {"type": "string", "minLength": 1},
    "fields": {"const": ["strict_k10_feasible", "strict_k10_known_mask", "identity", "step", "teacher_label_seal", "eligible_start_contract"]},
    "formal_selection_eligible": {"const": false},
    "training_authorized": {"const": false},
    "attack_authorized": {"const": false}
  }
}
