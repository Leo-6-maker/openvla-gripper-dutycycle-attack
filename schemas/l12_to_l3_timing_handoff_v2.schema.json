{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L12-to-L3 Timing Handoff v2",
  "description": "Schema for D5 trigger timing evidence shared with Layer3 attack experiments.",
  "type": "object",
  "required": ["production_tag", "task", "state_id", "split", "clean_success",
    "teacher_ws", "teacher_anchor", "teacher_we",
    "d5_emit", "d5_score", "emit_anchor_offset", "window_relation",
    "trace_sha256", "candidate_sha256", "source_commit", "primary_or_diagnostic"],
  "properties": {
    "production_tag": {"type": "string"},
    "task": {"type": "string"},
    "state_id": {"type": "integer"},
    "split": {"enum": ["train", "val"]},
    "clean_success": {"type": "integer", "minimum": 0, "maximum": 1},
    "teacher_ws": {"type": "integer"},
    "teacher_anchor": {"type": "integer"},
    "teacher_we": {"type": "integer"},
    "d5_emit": {"type": "integer"},
    "d5_score": {"type": "number"},
    "d5_tau_margin": {"type": "number"},
    "emit_anchor_offset": {"type": "integer"},
    "window_relation": {"enum": ["exact", "in_window_pre_anchor", "in_window_post_anchor", "early", "late", "miss"]},
    "first_close_step": {"type": "integer"},
    "first_close_anchor_offset": {"type": "integer"},
    "trace_path": {"type": "string"},
    "trace_sha256": {"type": "string"},
    "candidate_path": {"type": "string"},
    "candidate_sha256": {"type": "string"},
    "raw_frame_path": {"type": "string"},
    "raw_frame_sha256": {"type": "string"},
    "processor_tensor_sha256": {"type": "string"},
    "frame_step": {"type": "integer"},
    "frame_role": {"type": "string"},
    "preprocess_contract": {"type": "string"},
    "source_commit": {"type": "string"},
    "source_gpu_pair": {"type": "string"},
    "provenance_status": {"type": "string"},
    "primary_or_diagnostic": {"enum": ["primary", "diagnostic"]}
  }
}
