{
  "schema": "DETECTOR_V5_FACTORIZED_TEACHER_PROTOCOL_V1",
  "frozen_at": "2026-07-20",
  "scope": "FIT states 0-19 only, 800 identities, 176,336 steps",
  "teacher_type": "factorized_causal_physics_teacher",
  "supersedes": "DETECTOR_V5_PHYSICS_TEACHER_PROTOCOL_V21C_ACTION_CANONICAL",
  "design_constraint": "no threshold, loss, architecture, or route rule may be changed based on FIT-DEV, CAL, CHECK, CS200, or any attack result",

  "mechanism_routing": {
    "source": "BDDL task-role parser + task language only",
    "forbidden_sources": ["raw task ID", "state ID", "attack outcome", "detector output"],
    "routes": {
      "single_object_pick_place": {
        "description": "One manipulated object, one target container/region",
        "supported": true,
        "event_reset": "per-task single event"
      },
      "multi_object_transfer": {
        "description": "Multiple objects moved to different targets",
        "supported": true,
        "event_reset": "per-object event with release-triggered reset"
      },
      "articulated_or_planar": {
        "description": "Open/close doors, drawers, planar motions",
        "supported": false,
        "action": "abstain"
      },
      "unknown_or_ambiguous": {
        "description": "Cannot determine mechanism from BDDL",
        "supported": false,
        "action": "abstain"
      }
    }
  },

  "factorized_heads": {
    "grasp_established": {
      "description": "Object is stably held by the robot gripper",
      "known_mask_logic": "role.applicable AND action_known AND physics_valid",
      "cannot_require": "current raw action = CLOSE",
      "can_use": [
        "gripper_contact_score",
        "relative_pose_stability",
        "object_eef_comotion_score",
        "gripper_qpos_closure",
        "support_removal_or_lift_evidence",
        "no_recent_contact_loss"
      ],
      "prefix_invariant": true,
      "future_forbidden": true
    },
    "manipulation_active": {
      "description": "Grasped object is being transported, lifted, or placed",
      "known_mask_logic": "grasp_established_known AND grasp_established=True",
      "implies": "grasp_established",
      "can_use": [
        "lift_score",
        "horizontal_transport_evidence",
        "support_removed",
        "object_eef_comotion_score",
        "target_progress"
      ],
      "prefix_invariant": true,
      "future_forbidden": true
    },
    "release_or_instability": {
      "description": "Object is being released, dropped, slipping, or regrasped",
      "known_mask_logic": "role.applicable AND action_known",
      "can_use": [
        "opening_trend",
        "contact_loss",
        "object_eef_distance_increase",
        "relative_stability_decline",
        "object_drop_evidence",
        "contact_toggle_rate"
      ],
      "prefix_invariant": true,
      "future_forbidden": true
    },
    "strict_k10_feasible": {
      "description": "Evaluation-only: would a future K10 event label be feasible at this step?",
      "training_target": false,
      "runtime_available": false,
      "future_allowed": true,
      "known_mask_logic": "role.applicable AND close_event_onset"
    }
  },

  "inherited_from_v21c": {
    "score_window_steps": 5,
    "minimum_stable_grasp_dwell": 10,
    "relative_position_scale_m": 0.03,
    "relative_quaternion_scale": 0.20,
    "lift_scale_m": 0.03,
    "target_progress_scale_m": 0.20,
    "action_contract": "CANONICAL_ACTION_CONTRACT_V1"
  },

  "deleted_from_v21c": [
    "future_open in primary head formulas",
    "utility_tier as single composite target",
    "phase_name as training target",
    "candidate_close as hard grasp gate",
    "global known_mask"
  ],

  "event_model": {
    "event_boundary": "release_or_instability AND subsequent grasp_established signals new event",
    "event_id": "monotonic integer per episode",
    "event_role": "TARGET / DISTRACTOR / NONE",
    "target_definition": "manipulated_object from BDDL task role",
    "close_event_onset": "first step where action_intent=CLOSE AND grasp_established transitions False→True"
  },

  "geometry_gate_requirements": {
    "identities": 800,
    "steps": 176336,
    "missing_or_duplicate": 0,
    "source_mutation": 0,
    "prefix_invariance_violation": 0,
    "logical_violation": 0,
    "supported_event_reset_error": 0,
    "per_route_min_tasks_with_positive": 3,
    "per_route_min_positive_events": 30,
    "per_head_positive_negative_both": true,
    "grasp_positive_segment_median_length_min": 10,
    "release_positive_min_episodes": 20,
    "single_task_max_route_positive_pct": 35
  },

  "formal_training_authorized": false,
  "formal_attack_authorized": false
}
