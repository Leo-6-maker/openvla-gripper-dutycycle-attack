    "pooled_pair_weighted_auc": "sum_correct_pair_weights / sum_all_parent_pairs",
    "top_k": "select the highest K eligible probes per parent; parents with fewer than K eligible probes are excluded from that K metric",
    "random_baseline": "unweighted_mean of each eligible parent's positive prevalence",
    "top_k_lift": "macro_selected_positive_rate / macro_random_baseline",
